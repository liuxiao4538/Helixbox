# UCI 默认配置，安装时落到 /etc/config/helixbox

config settings 'main'
	option enabled '0'            # 加速总开关：1 开启，0 关闭
	option webserver 'lighttpd'   # 重定向服务：lighttpd（V1）
	option uhttpd_port '8080'     # 让出 80 后 LuCI 管理页的新端口
	option ipv6_block '0'         # 是否注入屏蔽 Xbox IPv6 的防火墙规则
	option auto_test '0'          # 是否定时自动测速并更新最优 IP
	option test_interval '24'     # 自动测速间隔（小时）
	option last_update ''         # 上次刷新最优 IP 的时间

# 三类下载域名的国内 CDN IP（测速后自动填入，也可手动改）
config ipgroup 'primary'
	option label '主下载域名 (assets/d1/d2)'
	list domain 'assets1.xboxlive.cn'
	list domain 'assets2.xboxlive.cn'
	list domain 'd1.xboxlive.cn'
	list domain 'd2.xboxlive.cn'
	option ip ''                  # 当前生效 IP
	option isp ''                 # 该 IP 的运营商（来自官方 IP 库）

config ipgroup 'legacy'
	option label '老游戏域名 (dlassets)'
	list domain 'dlassets.xboxlive.cn'
	list domain 'dlassets2.xboxlive.cn'
	option ip ''
	option isp ''

config ipgroup 'storeapp'
	option label '应用与 PC 游戏域名'
	list domain 'dl.delivery.mp.microsoft.com'
	list domain 'tlu.dl.delivery.mp.microsoft.com'
	option ip ''
	option isp ''
